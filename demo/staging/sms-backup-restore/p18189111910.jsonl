{"guid":"sbr-extra-+18189111910-28","timestamp_unix_ms":1747373524599,"direction":"outgoing","service":"sms","message_kind":"sms","sender_handle":null,"sender_display_name":null,"subject":null,"text":"Darcy called on his sister to join him in expressing their wish of seeing Mr.","attachments":[],"imessage":null,"source":null}
