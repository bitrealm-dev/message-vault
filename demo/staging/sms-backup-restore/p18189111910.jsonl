{"guid":"sbr-extra-+18189111910-49","timestamp_unix_ms":1747374784599,"direction":"incoming","service":"sms","message_kind":"sms","sender_handle":"+18189111910","sender_display_name":null,"subject":null,"text":"The housekeeper came forward, and told them it was the picture of a young gentleman, the son of her late master's steward, who had been brought up by him at his own expense.","attachments":[],"imessage":null,"source":null}
{"guid":"sbr-extra-+18189111910-50","timestamp_unix_ms":1747374844599,"direction":"incoming","service":"sms","message_kind":"sms","sender_handle":"+18189111910","sender_display_name":null,"subject":null,"text":"There were two nephews of Lady Catherine to require them, for Mr.","attachments":[],"imessage":null,"source":null}
