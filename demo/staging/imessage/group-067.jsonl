{"guid":"grp-67-91","timestamp_unix_ms":1770192482608,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":"His air was grave and stately, and his manners were very formal.","attachments":[],"imessage":null,"source":null}
