{"guid":"grp-103-1","timestamp_unix_ms":1723142313959,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+813856040795","sender_display_name":null,"subject":null,"text":"Will you allow me, or do I ask too much, to introduce my sister to your acquaintance during your stay at Lambton?","attachments":[],"imessage":null,"source":null}
{"guid":"grp-103-2","timestamp_unix_ms":1727848185690,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+13018162024","sender_display_name":null,"subject":null,"text":"The least agreeable circumstance in the business was the surprise it must occasion to Elizabeth Bennet, whose friendship she valued beyond that of any other person.","attachments":[],"imessage":null,"source":null}
{"guid":"grp-103-3","timestamp_unix_ms":1732196896842,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+18589706798","sender_display_name":null,"subject":null,"text":"Her power was sinking; everything _must_ sink under such a proof of family weakness, such an assurance of the deepest disgrace.","attachments":[],"imessage":null,"source":null}
