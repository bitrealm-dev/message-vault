{"guid":"grp-103-5","timestamp_unix_ms":1740309189333,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+813856040795","sender_display_name":null,"subject":null,"text":"As the day of his arrival drew near,-- \"I begin to be sorry that he comes at all,\" said Jane to her sister.","attachments":[],"imessage":null,"source":null}
