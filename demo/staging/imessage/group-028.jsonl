{"guid":"grp-28-75","timestamp_unix_ms":1780215270275,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+17863709375","sender_display_name":null,"subject":null,"text":" \"Yes, my youngest is not sixteen.","attachments":[],"imessage":null,"source":null}
