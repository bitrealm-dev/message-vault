{"guid":"grp-28-77","timestamp_unix_ms":1782419621216,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":"Tell her that you insist upon her marrying him. It was necessary to laugh when she would rather have cried.","attachments":[],"imessage":null,"source":null}
