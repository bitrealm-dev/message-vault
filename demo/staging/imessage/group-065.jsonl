{"guid":"grp-65-84","timestamp_unix_ms":1777729554214,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":" \"That is very strange. You may remember what I told you on that point, when first we talked of it.","attachments":[],"imessage":null,"source":null}
