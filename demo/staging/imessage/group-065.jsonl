{"guid":"grp-65-86","timestamp_unix_ms":1780019120743,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+14158951551","sender_display_name":null,"subject":null,"text":" The period of expectation was now doubled.","attachments":[],"imessage":null,"source":null}
