{"guid":"grp-205-105","timestamp_unix_ms":1772674698757,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":"I was sure you loved your girls too well to neglect such an acquaintance.","attachments":[],"imessage":null,"source":null}
{"guid":"grp-205-106","timestamp_unix_ms":1773277734797,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+13103776301","sender_display_name":null,"subject":null,"text":"However, he wrote some verses on her, and very pretty they were. He dined with us the next day, and was to leave town again on Wednesday or Thursday.","attachments":[],"imessage":null,"source":null}
