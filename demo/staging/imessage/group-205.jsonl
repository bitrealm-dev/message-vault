{"guid":"grp-205-116","timestamp_unix_ms":1779236237712,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+13103776301","sender_display_name":null,"subject":null,"text":" \"But people themselves alter so much, that there is something new to be observed in them for ever.","attachments":[],"imessage":null,"source":null}
