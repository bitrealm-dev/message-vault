{"guid":"1to1-+13136168017-107","timestamp_unix_ms":1760185122405,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":" \"And have you heard from him often?","attachments":[],"imessage":null,"source":null}
{"guid":"1to1-+13136168017-108","timestamp_unix_ms":1760188988405,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+13136168017","sender_display_name":null,"subject":null,"text":"O that he had sprained his ancle in the first dance!","attachments":[],"imessage":null,"source":null}
{"guid":"1to1-+13136168017-109","timestamp_unix_ms":1760189361405,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":" \"Certainly, my dear, nobody said there were; but as to not meeting with many people in this neighbourhood, I believe there are few neighbourhoods larger.","attachments":[],"imessage":null,"source":null}
{"guid":"1to1-+13136168017-110","timestamp_unix_ms":1760190423405,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":" \"Certainly,\" replied Elizabeth, \"there are such people, but I hope I am not one of _them_.","attachments":[],"imessage":null,"source":null}
{"guid":"1to1-+13136168017-111","timestamp_unix_ms":1775643599405,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+13136168017","sender_display_name":null,"subject":null,"text":"Long has promised to introduce him.","attachments":[],"imessage":null,"source":null}
