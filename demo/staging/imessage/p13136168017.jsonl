{"guid":"1to1-+13136168017-104","timestamp_unix_ms":1760165741405,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":"If he _had another_ motive, I am sure it would never disgrace him. But however insincere _you_ may choose to be, you shall not find _me_ so.","attachments":[],"imessage":null,"source":null}
