{"guid":"1to1-+13136168017-92","timestamp_unix_ms":1748869118405,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":"Darcy, for now they _do_ appear wholly undeserved.","attachments":[],"imessage":null,"source":null}
