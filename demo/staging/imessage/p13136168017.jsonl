{"guid":"1to1-+13136168017-94","timestamp_unix_ms":1751684522405,"direction":"outgoing","service":"rcs","message_kind":"sms","sender_handle":null,"sender_display_name":null,"subject":null,"text":" \"And do not you think him a very handsome gentleman, ma'am?","attachments":[],"imessage":null,"source":null}
{"guid":"1to1-+13136168017-95","timestamp_unix_ms":1751686128405,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":"She felt that Jane's feelings, though fervent, were little displayed, and that there was a constant complacency in her air and manner, not often united with great sensibility.","attachments":[],"imessage":null,"source":null}
{"guid":"1to1-+13136168017-96","timestamp_unix_ms":1751698933405,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+13136168017","sender_display_name":null,"subject":null,"text":" \"I am talking of possibilities, Charles.","attachments":[],"imessage":null,"source":null}
{"guid":"1to1-+13136168017-97","timestamp_unix_ms":1751717601405,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":"how can it affect them?","attachments":[],"imessage":null,"source":null}
{"guid":"1to1-+13136168017-98","timestamp_unix_ms":1751723662405,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":"There was also a legacy of one thousand pounds.","attachments":[],"imessage":null,"source":null}
