{"guid":"grp-43-15","timestamp_unix_ms":1784467985407,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+18586849961","sender_display_name":null,"subject":null,"text":"Who _could_ about such a nasty little freckled thing?","attachments":[],"imessage":null,"source":null}
