{"guid":"grp-105-0","timestamp_unix_ms":1785226196430,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":" He then went away, and Miss Bingley was left to all the satisfaction of having forced him to say what gave no one any pain but herself.","attachments":[],"imessage":null,"source":null}
{"guid":"grp-105-1","timestamp_unix_ms":1785301622430,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+15122692143","sender_display_name":null,"subject":null,"text":"But, however, he did not.","attachments":[],"imessage":null,"source":null}
