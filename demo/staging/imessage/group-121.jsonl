{"guid":"grp-121-78","timestamp_unix_ms":1785703990162,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+13103908593","sender_display_name":null,"subject":null,"text":"I confess,\" said he, \"that I should not have been at all surprised by her Ladyship's asking us on Sunday to drink tea and spend the evening at Rosings.","attachments":[],"imessage":null,"source":null}
