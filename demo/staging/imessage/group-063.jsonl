{"guid":"grp-63-10","timestamp_unix_ms":1786099776679,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+12013924356","sender_display_name":null,"subject":null,"text":"I shall offer to pay him to-morrow, he will rant and storm about his love for you, and there will be an end of the matter.","attachments":[],"imessage":null,"source":null}
{"guid":"grp-63-11","timestamp_unix_ms":1786104684679,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+18323700367","sender_display_name":null,"subject":null,"text":"I have been a selfish being all my life, in practice, though not in principle.","attachments":[],"imessage":null,"source":null}
