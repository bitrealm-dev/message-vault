{"guid":"grp-63-7","timestamp_unix_ms":1786073811679,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":" \"I wish I could say anything to comfort you,\" replied Elizabeth; \"but it is wholly out of my power.","attachments":[],"imessage":null,"source":null}
{"guid":"grp-63-8","timestamp_unix_ms":1786087103679,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+19165529655","sender_display_name":null,"subject":null,"text":"Darcy had considerable patronage in the church, and his cousin could have none at all.","attachments":[],"imessage":null,"source":null}
