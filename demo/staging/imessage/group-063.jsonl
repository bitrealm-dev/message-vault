{"guid":"grp-63-18","timestamp_unix_ms":1786249676679,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+19165529655","sender_display_name":null,"subject":null,"text":"Nor was Darcy's vindication, though grateful to her feelings, capable of consoling her for such discovery. The first wish of my heart,\" said she to herself, \"is never more to be in company with either of them.","attachments":[],"imessage":null,"source":null}
