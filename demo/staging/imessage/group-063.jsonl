{"guid":"grp-63-13","timestamp_unix_ms":1786109901679,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+19165529655","sender_display_name":null,"subject":null,"text":"If there is no other objection to my marrying your nephew, I shall certainly not be kept from it by knowing that his mother and aunt wished him to marry Miss de Bourgh.","attachments":[],"imessage":null,"source":null}
{"guid":"grp-63-14","timestamp_unix_ms":1786237960679,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":"Is not general incivility the very essence of love?","attachments":[],"imessage":null,"source":null}
{"guid":"grp-63-15","timestamp_unix_ms":1786240371679,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+12013924356","sender_display_name":null,"subject":null,"text":"The one mis-sent must be first attended to; it had been written five days ago.","attachments":[],"imessage":null,"source":null}
