{"guid":"grp-185-10","timestamp_unix_ms":1785390482771,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+915942969281","sender_display_name":null,"subject":null,"text":"It was all over before I arrived; so my curiosity was not so dreadfully racked as _yours_ seems to have been.","attachments":[],"imessage":null,"source":null}
