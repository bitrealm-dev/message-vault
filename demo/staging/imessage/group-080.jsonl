{"guid":"grp-80-74","timestamp_unix_ms":1764669199594,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+17133022221","sender_display_name":null,"subject":null,"text":"I can hardly write for laughing.","attachments":[],"imessage":null,"source":null}
