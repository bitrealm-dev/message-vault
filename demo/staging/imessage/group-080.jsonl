{"guid":"grp-80-88","timestamp_unix_ms":1780237376355,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+17133022221","sender_display_name":null,"subject":null,"text":"Bennet the comfort of having a daughter well married; and she called at Longbourn rather oftener than usual to say how happy she was, though Mrs.","attachments":[],"imessage":null,"source":null}
