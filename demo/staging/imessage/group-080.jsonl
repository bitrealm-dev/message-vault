{"guid":"grp-80-85","timestamp_unix_ms":1776933049198,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+15039770139","sender_display_name":null,"subject":null,"text":" \"They have none of them much to recommend them,\" replied he: \"they are all silly and ignorant like other girls; but Lizzy has something more of quickness than her sisters.","attachments":[],"imessage":null,"source":null}
{"guid":"grp-80-86","timestamp_unix_ms":1778035398960,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+17133022221","sender_display_name":null,"subject":null,"text":"How much sooner one tires of anything than of a book!","attachments":[],"imessage":null,"source":null}
