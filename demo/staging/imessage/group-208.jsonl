{"guid":"grp-208-0","timestamp_unix_ms":1785717092803,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":"When that business was over, he applied to Miss Bingley and Elizabeth for the indulgence of some music.","attachments":[],"imessage":null,"source":null}
{"guid":"grp-208-1","timestamp_unix_ms":1785724542803,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+15038961375","sender_display_name":null,"subject":null,"text":" \"Not so much as I could wish, sir: but I dare say he may spend half his time here; and Miss Darcy is always down for the summer months.","attachments":[],"imessage":null,"source":null}
{"guid":"grp-208-2","timestamp_unix_ms":1785753113803,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+13157256014","sender_display_name":null,"subject":null,"text":" \"And we mean to treat you all,\" added Lydia; \"but you must lend us the money, for we have just spent ours at the shop out there.","attachments":[],"imessage":null,"source":null}
