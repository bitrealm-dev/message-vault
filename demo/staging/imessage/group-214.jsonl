{"guid":"grp-214-12","timestamp_unix_ms":1774092923945,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+18326666710","sender_display_name":null,"subject":null,"text":"or had you intended any more serious consequences?","attachments":[],"imessage":null,"source":null}
