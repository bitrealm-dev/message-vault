{"guid":"grp-214-10","timestamp_unix_ms":1771355848450,"direction":"incoming","service":"imessage","message_kind":"imessage","sender_handle":"+12152259568","sender_display_name":null,"subject":null,"text":"Will you come and see me? To Caroline's assertion of her brother's being partial to Miss Darcy, she paid no credit.","attachments":[],"imessage":null,"source":null}
