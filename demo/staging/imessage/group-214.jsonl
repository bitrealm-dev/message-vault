{"guid":"grp-214-7","timestamp_unix_ms":1767086992815,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":"It is on your account that he has been so frequently invited this week.","attachments":[],"imessage":null,"source":null}
