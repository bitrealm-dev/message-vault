{"guid":"grp-214-14","timestamp_unix_ms":1776761001406,"direction":"outgoing","service":"imessage","message_kind":"imessage","sender_handle":null,"sender_display_name":null,"subject":null,"text":" In a few minutes she was joined by Bingley, whose conference with her father had been short and to the purpose.","attachments":[],"imessage":null,"source":null}
