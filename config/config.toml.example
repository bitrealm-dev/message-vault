# Copy to config.toml and edit for your machine:
#   cp config/config.toml.example config/config.toml
#   cp config/contacts.csv.example config/contacts.csv
#   cp config/exclude.csv.example config/exclude.csv
#
# Real config/contacts/exclude files are gitignored.
#
# Instance config only: shared database path, per-account data root, and optional
# HTTP import server. Vault owner profiles and web login accounts live in SQLite
# (`vault_owners`, `accounts`). Create an account in the web UI, then import with
# `--account <username>` (CLI) or your Import API token (Message Exporters).
#
# Message Exporters writes JSONL + attachments and uploads with a source name.
# Source folders are not listed here — each import registers its own source for
# that account under data/<account_id>/<source_id>/.
#
# contacts.csv / exclude.csv templates (optional): copy the examples if you want
# starter files; runtime imports use data/<account_id>/contacts.csv and
# exclude.csv (created with empty headers on first use).
# Older contact_phones / preferred_phone DBs are not upgraded — wipe vault.db and re-import.

[paths]
db = "data/vault.db"
data_dir = "data"
assets_dir = "assets"
assets_converted_dir = "assets_converted"

# HTTP JSONL import API (`cargo run --release -- serve`).
# Auth uses per-account Import API tokens from the web Settings UI (not a host secret).
[server]
bind = "127.0.0.1:8080"
