{"guid":"wa-1to1-+813856040795-72","timestamp_unix_ms":1782104881855,"direction":"incoming","service":"whatsapp","message_kind":"sms","sender_handle":"+813856040795","sender_display_name":null,"subject":null,"text":"Had they no apprehension of anything before the elopement took place?","attachments":[],"imessage":null,"source":null}
