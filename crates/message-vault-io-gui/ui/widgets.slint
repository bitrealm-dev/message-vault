export component PageSummary inherits Text {
    in property <string> message;
    text: root.message;
    font-size: 12px;
    color: #555555;
    wrap: word-wrap;
    horizontal-stretch: 1;
    vertical-stretch: 0;
}

export component SectionHeading inherits Text {
    in property <string> title;
    text: root.title;
    font-size: 13px;
    font-weight: 700;
    vertical-alignment: center;
    vertical-stretch: 0;
    height: 28px;
}

export component SectionDivider inherits Rectangle {
    height: 1px;
    background: #c0c0c0;
    vertical-stretch: 0;
}

export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <bool> show-required: true;
    spacing: 8px;
    padding: 0;
    alignment: start;
    vertical-stretch: 0;
    height: 28px;

    Text {
        text: root.title;
        font-size: 13px;
        font-weight: 700;
        vertical-alignment: center;
        vertical-stretch: 0;
    }
    if root.show-required: Text {
        text: "* Required field";
        font-size: 11px;
        color: #555555;
        vertical-alignment: center;
        vertical-stretch: 0;
    }
}

export component ActionRow inherits HorizontalLayout {
    spacing: 8px;
    padding-top: FormMetrics.section-spacing;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    alignment: end;
    vertical-stretch: 0;
    @children
}

/// High-contrast tab button for Form / Log panel switches.
export component PanelTabButton inherits Rectangle {
    in property <string> title;
    in property <bool> active: false;
    in property <length> min-tab-width: 0px;
    callback clicked();

    height: 36px;
    min-width: root.min-tab-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 0px;
    background: root.active ? #ffffff : #e5e7eb;
    border-width: 0px;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        alignment: center;
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: root.active ? 700 : 600;
            color: root.active ? #111827 : #374151;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    // Active underline.
    if root.active: Rectangle {
        y: parent.height - 3px;
        height: 3px;
        width: parent.width;
        background: #1d4ed8;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Two-tab strip with clear selected / unselected contrast.
export component PanelTabBar inherits VerticalLayout {
    in-out property <int> current-index: 0;
    in property <string> first-title;
    in property <string> second-title;
    spacing: 0;
    padding: 0;
    vertical-stretch: 0;

    Rectangle {
        height: 38px;
        vertical-stretch: 0;
        background: #e5e7eb;

        HorizontalLayout {
            padding: 0;
            spacing: 0;
            alignment: start;
            PanelTabButton {
                title: root.first-title;
                active: root.current-index == 0;
                clicked => { root.current-index = 0; }
            }
            PanelTabButton {
                title: root.second-title;
                active: root.current-index == 1;
                // Wider hit target than the short "Log" label, but still content-sized.
                min-tab-width: 120px;
                clicked => { root.current-index = 1; }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }
    }
    Rectangle {
        height: 1px;
        vertical-stretch: 0;
        background: #9ca3af;
    }
}

/// Selectable, read-only log buffer with a dark terminal-style look.
export component LogTextView inherits Rectangle {
    in property <string> text;
    in-out property <length> viewport-y <=> scroll-view.viewport-y;
    out property <length> visible-height <=> scroll-view.visible-height;
    out property <length> viewport-height <=> scroll-view.viewport-height;
    callback scrolled <=> scroll-view.scrolled;

    border-width: 1px;
    border-color: #808080;
    background: #111827;
    vertical-stretch: 1;
    min-height: 160px;
    clip: true;

    ContextMenuArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        scroll-view := ScrollView {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            viewport-width: self.visible-width;
            viewport-height: max(self.visible-height, text-input.preferred-height);

            text-input := TextInput {
                width: 100%;
                text: root.text;
                read-only: true;
                single-line: false;
                // no-wrap: word-wrap on a multi-MB buffer freezes the UI thread.
                wrap: no-wrap;
                color: #e5e7eb;
                font-family: "monospace";
                font-size: 13px;
                selection-background-color: #2563eb;
                selection-foreground-color: #ffffff;
                page-height: scroll-view.visible-height;
            }
        }

        Menu {
            MenuItem {
                title: "Copy";
                activated => { text-input.copy(); }
            }
            MenuItem {
                title: "Select All";
                activated => { text-input.select-all(); }
            }
            MenuItem {
                title: "Copy All";
                activated => {
                    text-input.select-all();
                    text-input.copy();
                }
            }
        }
    }
}

// Fill-tab page shell: page margin only, children pack to top.
export component PageColumn inherits VerticalLayout {
    padding: FormMetrics.page-padding;
    spacing: FormMetrics.row-spacing;
    alignment: start;
    vertical-stretch: 1;
    width: 100%;
    height: 100%;
    @children
}

// Content column inside ScrollView: pinned to the viewport's top-left.
// Width follows the viewport so fields stretch; height tracks preferred size
// so expanding the window never vertically redistributes form rows.
export component ScrollForm inherits VerticalLayout {
    padding: FormMetrics.page-padding;
    spacing: FormMetrics.row-spacing;
    alignment: start;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    x: 0px;
    y: 0px;
    width: 100%;
    height: self.preferred-height;
    @children
}

// Scrollable form page whose content stays anchored at the top-left when the
// window grows. Extra space appears below/right; content scrolls when taller
// than the visible area.
export component AnchoredScrollPage inherits ScrollView {
    vertical-stretch: 1;
    horizontal-stretch: 1;
    // Match the visible width so fields stay left-aligned; height follows the
    // form so Flickable cannot center a shorter preferred-size layout.
    viewport-width: self.visible-width;
    viewport-height: form.preferred-height;

    form := ScrollForm {
        width: root.viewport-width;
        x: 0px;
        y: 0px;
        @children
    }
}
