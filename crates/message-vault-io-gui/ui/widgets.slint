            horizontal-stretch: 1;
            height: FormMetrics.row-height;
            vertical-stretch: 0;
        }
    }
}

export component StackedDateEdit inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder: "";
    in-out property <string> value;
    private property <Date> picker-date;
    private property <int> display-year;
    private property <int> display-month;
    private property <[string]> month-names: [
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    ];
    private property <[string]> weekday-names: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private property <int> first-weekday: root.weekday(root.display-year, root.display-month, 1);
    private property <int> month-days: root.days-in-month(root.display-year, root.display-month);
    callback date-for-text(string) -> Date;
    spacing: 2px;
    padding: 0;
    vertical-stretch: 0;

    function two-digits(value: int) -> string {
        return value < 10 ? "0\{value}" : "\{value}";
    }

    function days-in-month(year: int, month: int) -> int {
        if month == 2 {
            return (Math.mod(year, 400) == 0
                || (Math.mod(year, 4) == 0 && Math.mod(year, 100) != 0)) ? 29 : 28;
        }
        return (month == 4 || month == 6 || month == 9 || month == 11) ? 30 : 31;
    }

    function weekday(year: int, month: int, day: int) -> int {
        let adjusted-year = month < 3 ? year - 1 : year;
        let adjusted-month = month < 3 ? month + 12 : month;
        let year-of-century = Math.mod(adjusted-year, 100);
        let century = floor(adjusted-year / 100);
        let zeller = Math.mod(day + floor(13 * (adjusted-month + 1) / 5)
            + year-of-century + floor(year-of-century / 4)
            + floor(century / 4) + 5 * century, 7);
        return Math.mod(zeller + 5, 7);
    }

    function previous-month() {
        if root.display-month == 1 {
            root.display-month = 12;
            root.display-year -= 1;
        } else {
            root.display-month -= 1;
        }
    }

    function next-month() {
        if root.display-month == 12 {
            root.display-month = 1;
            root.display-year += 1;
        } else {
            root.display-month += 1;
        }
    }

    function open-picker() {
        root.picker-date = root.date-for-text(root.value);
        root.display-year = root.picker-date.year;
        root.display-month = root.picker-date.month;
        picker.show();
    }

    StackedFieldLabel { label: root.label; }
    HorizontalLayout {
        spacing: 0;
        padding: 0;
        alignment: stretch;
        vertical-stretch: 0;
        height: FormMetrics.row-height;
        Rectangle {
            width: FormMetrics.stacked-control-indent;
            horizontal-stretch: 0;
        }
        HorizontalLayout {
            spacing: FormMetrics.field-spacing;
            padding: 0;
            alignment: stretch;
            vertical-stretch: 0;
            horizontal-stretch: 1;
            height: FormMetrics.row-height;
            LineEdit {
                text <=> root.value;
                placeholder-text: root.placeholder;
                horizontal-stretch: 1;
                height: FormMetrics.row-height;
                vertical-stretch: 0;
            }
            Button {
                text: "▦";
                width: FormMetrics.button-width;
                height: FormMetrics.row-height;
                vertical-stretch: 0;
                horizontal-stretch: 0;
                clicked => { root.open-picker(); }
            }
        }
    }

    picker := PopupWindow {
        x: root.width - self.width;
        y: root.height;
        width: 252px;
        height: 246px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 3px;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 4px;

                    Button {
                        text: "‹";
                        width: 30px;
                        horizontal-stretch: 0;
                        clicked => { root.previous-month(); }
                    }
                    Text {
                        text: root.month-names[root.display-month - 1] + " " + root.display-year;
                        color: Palette.control-foreground;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "›";
                        width: 30px;
                        horizontal-stretch: 0;
                        clicked => { root.next-month(); }
                    }
                }

                Rectangle {
                    height: 20px;
                    vertical-stretch: 0;
                    for weekday[index] in root.weekday-names: Text {
                        x: index * parent.width / 7;
                        width: parent.width / 7;
                        height: parent.height;
                        text: weekday;
                        color: Palette.alternate-foreground;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    for cell[index] in 42: day-cell := Rectangle {
                        property <int> day: index - root.first-weekday + 1;
                        property <bool> valid: self.day >= 1 && self.day <= root.month-days;
                        property <bool> selected: self.valid
                            && root.picker-date.year == root.display-year
                            && root.picker-date.month == root.display-month
                            && root.picker-date.day == self.day;
                        x: Math.mod(index, 7) * parent.width / 7;
                        y: floor(index / 7) * parent.height / 6;
                        width: parent.width / 7;
                        height: parent.height / 6;
                        border-radius: 3px;
                        background: self.selected
                            ? Palette.selection-background
                            : day-touch.has-hover && self.valid
                                ? Palette.alternate-background
                                : Palette.background;

                        Text {
                            text: day-cell.valid ? day-cell.day : "";
                            color: day-cell.selected
                                ? Palette.selection-foreground
                                : Palette.control-foreground;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        day-touch := TouchArea {
                            enabled: day-cell.valid;
                            clicked => {
                                root.picker-date = {
                                    year: root.display-year,
                                    month: root.display-month,
                                    day: day-cell.day
                                };
                                root.value = "\{root.picker-date.year}-\{root.two-digits(root.picker-date.month)}-\{root.two-digits(root.picker-date.day)}";
                                picker.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component StackedHint inherits HorizontalLayout {
    in property <string> message;
    spacing: 0;
    padding: 0;
    vertical-stretch: 0;
    Rectangle {
        width: FormMetrics.stacked-hint-indent;
        horizontal-stretch: 0;
    }
    Text {
        text: root.message;
        font-size: 11px;
        wrap: word-wrap;
        color: #555555;
        horizontal-stretch: 1;
        vertical-stretch: 0;
    }
}

export component StackedDangerHint inherits HorizontalLayout {
    in property <string> message;
    spacing: 0;
    padding: 0;
    vertical-stretch: 0;
    Rectangle {
        width: FormMetrics.stacked-hint-indent;
        horizontal-stretch: 0;
    }
    Text {
        text: root.message;
        font-size: 11px;
        wrap: word-wrap;
        color: #c0392b;
        horizontal-stretch: 1;
        vertical-stretch: 0;
    }
}

export component StackedCheckBox inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    spacing: 0;
    padding: 0;
    alignment: stretch;
    vertical-stretch: 0;
    height: FormMetrics.row-height;

    Rectangle {
        width: FormMetrics.stacked-control-indent;
        horizontal-stretch: 0;
    }
    CheckBox {
        text: root.text;
        checked <=> root.checked;
        enabled: root.enabled;
        horizontal-stretch: 1;
        vertical-stretch: 0;
        height: FormMetrics.row-height;
    }
}

/// Bordered group for related options (compress settings, advanced filters, …).
export component OptionGroup inherits Rectangle {
    in property <string> title: "";
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 6px;
    background: Palette.alternate-background;
    vertical-stretch: 0;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 10px;
        spacing: FormMetrics.section-spacing;
        vertical-stretch: 0;

        if root.title != "": Text {
            text: root.title;
            font-size: 12px;
            font-weight: 700;
            vertical-stretch: 0;
        }
        @children
    }
}

export component AdvancedSection inherits VerticalLayout {
    in-out property <bool> open: false;
    in property <string> title: "Advanced Options";
    // When true, wrap body fields in a bordered OptionGroup-style panel.
    in property <bool> grouped: true;
    spacing: FormMetrics.row-spacing;
    // Extra air above the heading so it separates from the prior section's last row.
    padding-top: 8px;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    vertical-stretch: 0;

    // Clickable text heading (not a Button) with a rule under the title.
    VerticalLayout {
        spacing: 0;
        padding: 0;
        vertical-stretch: 0;

        TouchArea {
            mouse-cursor: pointer;
            vertical-stretch: 0;
            clicked => { root.open = !root.open; }

            HorizontalLayout {
                padding: 0;
                spacing: 6px;
                alignment: start;
                vertical-stretch: 0;
                height: 30px;

                Text {
                    text: root.open ? "⌄" : "›";
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                }
                Text {
                    text: root.title;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: #c0c0c0;
            vertical-stretch: 0;
            horizontal-stretch: 1;
        }
    }

    // @children cannot live inside `if`; clip/height toggles visibility instead.
    // `grouped` applies OptionGroup chrome without duplicating @children.
    Rectangle {
        visible: root.open;
        height: root.open ? self.preferred-height : 0px;
        clip: true;
        vertical-stretch: 0;
        horizontal-stretch: 1;
        border-width: root.grouped ? 1px : 0px;
        border-color: Palette.border;
        border-radius: root.grouped ? 6px : 0px;
        background: root.grouped ? Palette.alternate-background : transparent;

        VerticalLayout {
            padding: root.grouped ? 10px : 0px;
            spacing: FormMetrics.section-spacing;
            vertical-stretch: 0;
            @children
        }
    }
}

// Hint indented under the editor column (not under the label).
export component Hint inherits HorizontalLayout {
    in property <string> message;
    spacing: FormMetrics.field-spacing;
    padding: 0;
    alignment: stretch;
    vertical-stretch: 0;

    Rectangle {
        width: FormMetrics.label-width;
        vertical-stretch: 0;
        horizontal-stretch: 0;
    }
    Text {
        text: root.message;
        font-size: 11px;
        wrap: word-wrap;
        color: #555555;
        horizontal-stretch: 1;
        vertical-stretch: 0;
    }
    Rectangle {
        width: FormMetrics.button-width;
        vertical-stretch: 0;
        horizontal-stretch: 0;
    }
}

export component DangerHint inherits HorizontalLayout {
    in property <string> message;
    spacing: FormMetrics.field-spacing;
    padding: 0;
    alignment: stretch;
    vertical-stretch: 0;

    Rectangle {
        width: FormMetrics.label-width;
        vertical-stretch: 0;
