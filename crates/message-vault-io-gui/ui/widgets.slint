import { Button, CheckBox, Date, LineEdit, Palette, ScrollView, TextEdit } from "std-widgets.slint";
import { CompactComboBox } from "compact-combo-box.slint";

// Classic desktop dialog grid:
//   [ right-aligned label | flexible control | trailing button ]
// IMPORTANT: use Layout primitives with padding: 0 — HorizontalBox/VerticalBox
// inject StyleMetrics.layout-padding (8px Fluent) and inflate every row.
export global FormMetrics {
    out property <length> label-width: 148px;
    out property <length> button-width: 36px;
    out property <length> field-spacing: 8px;
    out property <length> page-padding: 12px;
    out property <length> row-spacing: 10px;
    out property <length> section-spacing: 10px;
    out property <length> row-height: 32px;
    // Inset for stacked controls / checkboxes under their labels.
    out property <length> stacked-control-indent: 12px;
    // Align helper text with LineEdit content (control indent + field text padding).
    out property <length> stacked-hint-indent: 20px;
}

// Right-aligned label sitting in the fixed left column.
export component FieldLabel inherits HorizontalLayout {
    in property <string> label;
    in property <bool> required: false;
    width: FormMetrics.label-width;
    height: FormMetrics.row-height;
    spacing: 2px;
    padding: 0;
    alignment: end;
    vertical-stretch: 0;
    horizontal-stretch: 0;

    Text {
        text: root.label;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
        horizontal-stretch: 1;
        vertical-stretch: 0;
    }
    if root.required: Text {
        text: "*";
        font-size: 12px;
        color: #c0392b;
        vertical-alignment: center;
        vertical-stretch: 0;
        horizontal-stretch: 0;
    }
}

// Three-column form row: label | editor area | optional trailing button slot.
// Rows without a trailing button still reserve the button column so editors align.
export component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <bool> required: false;
    // When false, reserve an empty trailing button column for gutter alignment.
    in property <bool> has-trailing: false;
    spacing: FormMetrics.field-spacing;
    padding: 0;
    alignment: stretch;
    vertical-stretch: 0;
    height: self.preferred-height;

    FieldLabel {
        label: root.label;
        required: root.required;
    }

    HorizontalLayout {
        spacing: FormMetrics.field-spacing;
        padding: 0;
        alignment: stretch;
        horizontal-stretch: 1;
        vertical-stretch: 0;
        @children
    }

    if !root.has-trailing: Rectangle {
        width: FormMetrics.button-width;
        height: FormMetrics.row-height;
        vertical-stretch: 0;
        horizontal-stretch: 0;
    }
}

export component LabeledLineEdit inherits FormRow {
    in property <string> placeholder: "";
    in-out property <string> value;
    in property <bool> password: false;
    in property <bool> enabled: true;
    has-trailing: false;

    if !root.password: LineEdit {
        text <=> root.value;
        placeholder-text: root.placeholder;
        enabled: root.enabled;
        horizontal-stretch: 1;
        vertical-stretch: 0;
        height: FormMetrics.row-height;
    }
    if root.password: LineEdit {
        text <=> root.value;
        placeholder-text: root.placeholder;
        enabled: root.enabled;
        input-type: InputType.password;
        horizontal-stretch: 1;
        vertical-stretch: 0;
        height: FormMetrics.row-height;
    }
}

export component LabeledDateEdit inherits FormRow {
    in property <string> placeholder: "YYYY-MM-DD (optional)";
    in-out property <string> value;
    private property <Date> picker-date;
    private property <int> display-year;
    private property <int> display-month;
    private property <[string]> month-names: [
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    ];
    private property <[string]> weekday-names: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private property <int> first-weekday: root.weekday(root.display-year, root.display-month, 1);
    private property <int> month-days: root.days-in-month(root.display-year, root.display-month);
    callback date-for-text(string) -> Date;
    has-trailing: true;

    function two-digits(value: int) -> string {
        return value < 10 ? "0\{value}" : "\{value}";
    }

    function days-in-month(year: int, month: int) -> int {
        if month == 2 {
            return (Math.mod(year, 400) == 0
                || (Math.mod(year, 4) == 0 && Math.mod(year, 100) != 0)) ? 29 : 28;
        }
        return (month == 4 || month == 6 || month == 9 || month == 11) ? 30 : 31;
    }

    // Gregorian weekday, Monday = 0.
    function weekday(year: int, month: int, day: int) -> int {
        let adjusted-year = month < 3 ? year - 1 : year;
        let adjusted-month = month < 3 ? month + 12 : month;
        let year-of-century = Math.mod(adjusted-year, 100);
        let century = floor(adjusted-year / 100);
        let zeller = Math.mod(day + floor(13 * (adjusted-month + 1) / 5)
            + year-of-century + floor(year-of-century / 4)
            + floor(century / 4) + 5 * century, 7);
        return Math.mod(zeller + 5, 7);
    }

    function previous-month() {
        if root.display-month == 1 {
            root.display-month = 12;
            root.display-year -= 1;
        } else {
            root.display-month -= 1;
        }
    }

    function next-month() {
        if root.display-month == 12 {
            root.display-month = 1;
            root.display-year += 1;
        } else {
            root.display-month += 1;
        }
    }

    function open-picker() {
        root.picker-date = root.date-for-text(root.value);
        root.display-year = root.picker-date.year;
        root.display-month = root.picker-date.month;
        picker.show();
    }

    LineEdit {
        text <=> root.value;
        placeholder-text: root.placeholder;
        horizontal-stretch: 1;
        vertical-stretch: 0;
        height: FormMetrics.row-height;
    }
    Button {
        text: "▦";
        width: FormMetrics.button-width;
        height: FormMetrics.row-height;
        vertical-stretch: 0;
        horizontal-stretch: 0;
        clicked => { root.open-picker(); }
    }

    picker := PopupWindow {
        x: root.width - self.width;
        y: root.height;
        width: 252px;
        height: 246px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 3px;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 4px;

                    Button {
                        text: "‹";
                        width: 30px;
                        horizontal-stretch: 0;
                        clicked => { root.previous-month(); }
                    }
                    Text {
                        text: root.month-names[root.display-month - 1] + " " + root.display-year;
                        color: Palette.control-foreground;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "›";
                        width: 30px;
                        horizontal-stretch: 0;
                        clicked => { root.next-month(); }
                    }
                }

                Rectangle {
                    height: 20px;
                    vertical-stretch: 0;
                    for weekday[index] in root.weekday-names: Text {
                        x: index * parent.width / 7;
                        width: parent.width / 7;
                        height: parent.height;
                        text: weekday;
                        color: Palette.alternate-foreground;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    for cell[index] in 42: day-cell := Rectangle {
                        property <int> day: index - root.first-weekday + 1;
                        property <bool> valid: self.day >= 1 && self.day <= root.month-days;
                        property <bool> selected: self.valid
                            && root.picker-date.year == root.display-year
                            && root.picker-date.month == root.display-month
                            && root.picker-date.day == self.day;
                        x: Math.mod(index, 7) * parent.width / 7;
                        y: floor(index / 7) * parent.height / 6;
                        width: parent.width / 7;
                        height: parent.height / 6;
                        border-radius: 3px;
                        background: self.selected
                            ? Palette.selection-background
                            : day-touch.has-hover && self.valid
                                ? Palette.alternate-background
                                : Palette.background;

                        Text {
                            text: day-cell.valid ? day-cell.day : "";
                            color: day-cell.selected
                                ? Palette.selection-foreground
                                : Palette.control-foreground;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        day-touch := TouchArea {
                            enabled: day-cell.valid;
                            clicked => {
                                root.picker-date = {
                                    year: root.display-year,
                                    month: root.display-month,
                                    day: day-cell.day
                                };
                                root.value = "\{root.picker-date.year}-\{root.two-digits(root.picker-date.month)}-\{root.two-digits(root.picker-date.day)}";
                                picker.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component LabeledTextEdit inherits FormRow {
    in property <string> placeholder: "";
    in-out property <string> value;
    has-trailing: false;

    TextEdit {
        text <=> root.value;
        horizontal-stretch: 1;
        vertical-stretch: 0;
        preferred-height: 56px;
        min-height: 56px;
    }
}

export component LabeledPathField inherits FormRow {
    in property <string> placeholder: "";
    in property <string> field-id;
    in-out property <string> value;
    callback browse-requested(string);
    has-trailing: true;

    LineEdit {
        text <=> root.value;
        placeholder-text: root.placeholder;
        horizontal-stretch: 1;
        vertical-stretch: 0;
        height: FormMetrics.row-height;
    }
    Button {
        text: "…";
        width: FormMetrics.button-width;
        height: FormMetrics.row-height;
        vertical-stretch: 0;
        horizontal-stretch: 0;
        clicked => { root.browse-requested(root.field-id); }
    }
}

export component LabeledComboBox inherits FormRow {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <int> separator-before-index: -1;
    callback selected(string);
    has-trailing: false;

    CompactComboBox {
        model: root.model;
        current-index <=> root.current-index;
        separator-before-index: root.separator-before-index;
        selected(value) => { root.selected(value); }
        horizontal-stretch: 1;
        vertical-stretch: 0;
        height: FormMetrics.row-height;
    }
}

// Checkbox indented so the box aligns with the editor gutter.
export component CheckBoxRow inherits FormRow {
    in property <string> text;
    in-out property <bool> checked;
    label: "";
    has-trailing: false;

    CheckBox {
        text: root.text;
        checked <=> root.checked;
        horizontal-stretch: 1;
        vertical-stretch: 0;
        height: FormMetrics.row-height;
    }
}

/// Label above the control (guided Import / Credentials layout).
/// Indented to match `stacked-control-indent` so headings line up with text fields.
export component StackedFieldLabel inherits HorizontalLayout {
    in property <string> label;
    in property <bool> required: false;
    spacing: 0;
    padding: 0;
    alignment: start;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    height: 22px;

    Rectangle {
        width: FormMetrics.stacked-control-indent;
        horizontal-stretch: 0;
        vertical-stretch: 0;
        height: 22px;
    }
    HorizontalLayout {
        spacing: 2px;
        padding: 0;
        alignment: start;
        vertical-stretch: 0;
        horizontal-stretch: 1;
        height: 22px;
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        if root.required: Text {
            text: "*";
            font-size: 12px;
            font-weight: 700;
            color: #c0392b;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

export component StackedLineEdit inherits VerticalLayout {
    in property <string> label;
    in property <bool> required: false;
    in property <string> placeholder: "";
    in-out property <string> value;
    in property <bool> password: false;
    in property <bool> enabled: true;
    spacing: 2px;
    padding: 0;
    vertical-stretch: 0;

    StackedFieldLabel {
        label: root.label;
        required: root.required;
    }
    HorizontalLayout {
        spacing: 0;
        padding: 0;
        alignment: stretch;
        vertical-stretch: 0;
        height: FormMetrics.row-height;
        Rectangle {
            width: FormMetrics.stacked-control-indent;
            horizontal-stretch: 0;
        }
        if !root.password: LineEdit {
            text <=> root.value;
            placeholder-text: root.placeholder;
            enabled: root.enabled;
            horizontal-stretch: 1;
            height: FormMetrics.row-height;
            vertical-stretch: 0;
        }
        if root.password: LineEdit {
            text <=> root.value;
            placeholder-text: root.placeholder;
            enabled: root.enabled;
            input-type: InputType.password;
            horizontal-stretch: 1;
            height: FormMetrics.row-height;
            vertical-stretch: 0;
        }
    }
}

export component StackedPathField inherits VerticalLayout {
    in property <string> label;
    in property <bool> required: false;
    in property <string> placeholder: "";
    in property <string> field-id;
    in-out property <string> value;
    callback browse-requested(string);
    spacing: 2px;
    padding: 0;
    vertical-stretch: 0;

    StackedFieldLabel {
        label: root.label;
        required: root.required;
    }
    HorizontalLayout {
        spacing: 0;
        padding: 0;
        alignment: stretch;
        vertical-stretch: 0;
        height: FormMetrics.row-height;
        Rectangle {
            width: FormMetrics.stacked-control-indent;
            horizontal-stretch: 0;
        }
        HorizontalLayout {
            spacing: FormMetrics.field-spacing;
            padding: 0;
            alignment: stretch;
            vertical-stretch: 0;
            horizontal-stretch: 1;
            height: FormMetrics.row-height;
            LineEdit {
                text <=> root.value;
                placeholder-text: root.placeholder;
                horizontal-stretch: 1;
                height: FormMetrics.row-height;
                vertical-stretch: 0;
            }
            Button {
                text: "Browse…";
                horizontal-stretch: 0;
                height: FormMetrics.row-height;
                vertical-stretch: 0;
                clicked => { root.browse-requested(root.field-id); }
            }
        }
    }
}

export component StackedComboBox inherits VerticalLayout {
    in property <string> label;
    in property <bool> required: false;
    in property <[string]> model;
    in-out property <int> current-index;
    in property <int> separator-before-index: -1;
    callback selected(string);
    spacing: 2px;
    padding: 0;
    vertical-stretch: 0;

