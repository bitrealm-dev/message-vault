import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

component CompactPopupEntry inherits VerticalLayout {
    in property <string> label;
    in property <int> index;
    in property <bool> selected;
    in property <bool> show-separator;
    callback chosen(int);
    spacing: 2px;
    padding: 0;
    vertical-stretch: 0;

    if root.show-separator: HorizontalLayout {
        height: 20px;
        spacing: 6px;
        padding-left: 8px;
        padding-right: 8px;
        vertical-stretch: 0;

        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }
        }
        Text {
            text: "Experimental";
            color: Theme.muted;
            font-size: 10px;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }
        }
    }

    option-row := Rectangle {
        height: 24px;
        background: root.selected
            ? Theme.selection
            : option-touch.has-hover ? Theme.elevated : Theme.panel;
        vertical-stretch: 0;

        Text {
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            text: root.label;
            color: root.selected ? Theme.selection-text : Theme.text;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        option-touch := TouchArea {
            clicked => { root.chosen(root.index); }
        }
    }
}

export component CompactComboBox {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    in property <int> separator-before-index: -1;
    callback selected(string);

    property <length> popup-padding: 3px;
    property <length> popup-row-height: 24px;
    property <int> visible-items: min(8, root.model.length);
    property <bool> has-separator:
        root.separator-before-index >= 0 && root.separator-before-index < root.model.length;
    property <string> current-value:
        root.current-index >= 0 && root.current-index < root.model.length
            ? root.model[root.current-index]
            : "";

    min-width: 160px;
    min-height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: closed-focus;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;
    accessible-value: root.current-value;

    public function select(index: int) {
        if !root.enabled || index < 0 || index >= root.model.length {
            return;
        }
        root.current-index = index;
        root.selected(root.model[index]);
    }

    public function move-up() {
        root.select(max(0, root.current-index - 1));
    }

    public function move-down() {
        root.select(min(root.model.length - 1, root.current-index + 1));
    }

    public function open-popup() {
        if root.enabled && root.model.length > 0 {
            popup.show();
        }
    }

    closed-background := Rectangle {
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.border;
        background: closed-touch.has-hover && root.enabled
            ? Theme.elevated
            : Theme.panel;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;

            Text {
                text: root.current-value;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: "⌄";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }

        closed-focus := FocusScope {
            enabled: root.enabled;
            key-pressed(event) => {
                if event.text == Key.UpArrow {
                    root.move-up();
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.move-down();
                    return accept;
                }
                if event.text == Key.Return || event.text == Key.Space {
                    root.open-popup();
                    return accept;
                }
                return reject;
            }

            closed-touch := TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.focus();
                    root.open-popup();
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height;
        width: root.width;
        height: root.visible-items * root.popup-row-height
            + (root.has-separator ? 22px : 0px)
            + 2 * root.popup-padding;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;

        popup-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.UpArrow {
                    root.move-up();
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.move-down();
                    return accept;
                }
                if event.text == Key.Return || event.text == Key.Space || event.text == Key.Escape {
                    popup.close();
                    return accept;
                }
                return reject;
            }

            Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 3px;

                ScrollView {
                    viewport-y: -max(0, root.current-index - root.visible-items + 1)
                        * root.popup-row-height;

                    VerticalLayout {
                        alignment: start;
                        padding: root.popup-padding;
                        spacing: 0;

                        for value[index] in root.model: CompactPopupEntry {
                            label: value;
                            index: index;
                            selected: index == root.current-index;
                            show-separator: root.has-separator
                                && index == root.separator-before-index;
                            chosen(index) => {
                                root.select(index);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
