import {
    Button
} from "std-widgets.slint";
import { Theme } from "theme.slint";
import { HomePage } from "pages/home.slint";
import { CredentialsPage } from "pages/credentials.slint";
import { ImportPage, ImportAdapter } from "pages/import.slint";
import { VaultExportPage } from "pages/vault-export.slint";

// Legacy screens kept for reference until the final deprecation pass.
// The page components remain in ui/pages/ but are not shown in the guided workflow.
export { ContactsAdapter } from "pages/contacts.slint";
export { ExtractAdapter } from "pages/extract.slint";
export { FormatAdapter } from "pages/format.slint";
export { VaultAdapter } from "pages/vault.slint";
export { LogAdapter } from "pages/log.slint";

export { HomeAdapter } from "pages/home.slint";
export { CredentialsAdapter } from "pages/credentials.slint";
export { ImportAdapter } from "pages/import.slint";
export { VaultExportAdapter } from "pages/vault-export.slint";
export { Theme, AppearanceAdapter } from "theme.slint";

export component AppWindow inherits Window {
    // OS title bar text; version is filled in from Rust (CARGO_PKG_VERSION).
    in-out property <string> app-title: "Message Vault";
    title: root.app-title;
    preferred-width: 920px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 560px;
    default-font-size: 12px;
    background: Theme.bg;

    // Grow via Rust set_size (not root.height — that locks manual resize).
    callback grow-for-advanced();
    property <bool> import-section-open:
        ImportAdapter.ios-advanced
        || ImportAdapter.advanced
        || ImportAdapter.processing-open;
    changed import-section-open => {
        if (root.import-section-open && root.workflow-screen == 2) {
            root.grow-for-advanced();
        }
    }

    // 0 = Home, 1 = Vault Credentials, 2 = Import Messages, 3 = Vault Export
    in-out property <int> workflow-screen: 0;
    in property <string> error-text;
    // Screen that produced the error; -1 means no active error.
    in property <int> error-source-screen: -1;
    in property <string> status-text: "Ready";
    in property <bool> workflow-enabled: true;
    property <bool> show-error:
        root.error-text != ""
        && root.error-source-screen >= 0
        && root.workflow-screen == root.error-source-screen;
    callback close-requested();
    callback error-dismissed();
    callback navigate-back();

    property <string> back-label:
        root.workflow-screen == 2 || root.workflow-screen == 3 ? "Vault Credentials"
        : root.workflow-screen == 1 ? "Home"
        : "";

    // Use Layout (not Box): Box widgets inject StyleMetrics.layout-padding.
    VerticalLayout {
        padding: 0;
        spacing: 0;

        if root.workflow-screen > 0: Rectangle {
            vertical-stretch: 0;
            background: Theme.chrome;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;
                alignment: start;

                Button {
                    text: "← " + root.back-label;
                    enabled: root.workflow-enabled;
                    clicked => { root.navigate-back(); }
                }
            }
        }

        if root.show-error: Rectangle {
            background: Theme.danger-bg;
            vertical-stretch: 0;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 12px;

                Text {
                    text: "Could not continue:\n" + root.error-text;
                    color: Theme.danger-text;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    font-size: 12px;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                }
                Button {
                    text: "Dismiss";
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    clicked => { root.error-dismissed(); }
                }
            }
        }

        if root.workflow-screen == 0: HomePage { }

        if root.workflow-screen == 1: CredentialsPage { }

        if root.workflow-screen == 2: ImportPage { }

        if root.workflow-screen == 3: VaultExportPage { }

        Rectangle {
            height: 24px;
            vertical-stretch: 0;
            background: Theme.chrome;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: stretch;
                Text {
                    text: root.status-text;
                    font-size: 11px;
                    color: Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
