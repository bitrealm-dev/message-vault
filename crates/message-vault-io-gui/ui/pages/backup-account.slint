import { Button } from "std-widgets.slint";
import {
    LabeledLineEdit, LabeledPathField, Hint, ActionRow, PageSummary,
    CheckBoxRow, AnchoredScrollPage, SectionHeading
} from "../widgets.slint";

export global BackupAccountAdapter {
    in-out property <string> url;
    in-out property <string> key;
    in-out property <string> output;
    in-out property <bool> force;
    in property <bool> enabled: true;

    callback browse(string);
    callback run();
}

export component BackupAccountPage inherits AnchoredScrollPage {
    SectionHeading {
        title: "Backup Account";
    }
    PageSummary {
        message: "Download your entire message history from Message Vault.";
    }

    LabeledLineEdit {
        label: "Vault URL";
        placeholder: "http://127.0.0.1:8080 or https://app.bitrealm.dev";
        value <=> BackupAccountAdapter.url;
    }
    Hint {
        message: "Include the port when needed (local serve is usually http://127.0.0.1:8080).";
    }
    LabeledLineEdit {
        label: "API Key";
        password: true;
        placeholder: "Generated in Vault Settings";
        value <=> BackupAccountAdapter.key;
    }
    LabeledPathField {
        label: "Output Directory";
        placeholder: "Where to write the downloaded backup";
        field-id: "backup.output";
        value <=> BackupAccountAdapter.output;
        browse-requested(id) => { BackupAccountAdapter.browse(id); }
    }

    CheckBoxRow {
        text: "Force full backup (ignore previous state)";
        checked <=> BackupAccountAdapter.force;
    }

    ActionRow {
        Button {
            text: "Backup Account";
            primary: true;
            enabled: BackupAccountAdapter.enabled;
            clicked => { BackupAccountAdapter.run(); }
        }
    }
}
