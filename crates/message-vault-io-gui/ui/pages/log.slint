import { Button, ListView, Spinner } from "std-widgets.slint";
import {
    ActionRow, PageSummary, FormMetrics
} from "../widgets.slint";

export global LogAdapter {
    in property <[string]> lines;
    in property <bool> running;
    in property <string> session-log-name;
    callback cancel();
    callback clear-view();
}

export component LogPage inherits VerticalLayout {
    padding: FormMetrics.page-padding;
    spacing: FormMetrics.row-spacing;
    alignment: stretch;

    // Follow new output unless the user scrolls up to read history.
    private property <bool> stick-to-end: true;
    private property <int> line-count: LogAdapter.lines.length;

    changed line-count => {
        if root.stick-to-end {
            scroll-timer.running = true;
        }
    }

    function scroll-to-end() {
        log-view.viewport-y = min(0px, log-view.visible-height - log-view.viewport-height);
    }

    // ListView geometry often updates a frame after the model; defer the snap.
    scroll-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            if root.stick-to-end {
                root.scroll-to-end();
            }
        }
    }

    // Keep following while a job streams lines (covers layout lag after push).
    follow-timer := Timer {
        interval: 100ms;
        running: LogAdapter.running && root.stick-to-end;
        triggered => { root.scroll-to-end(); }
    }

    PageSummary {
        message: "Review progress and errors from the current or most recent operation.";
    }

    HorizontalLayout {
        spacing: 8px;
        padding: 0;
        alignment: start;
        vertical-stretch: 0;
        if LogAdapter.running: Spinner { }
        Text {
            text: LogAdapter.session-log-name == "" ? "(no session log)" : LogAdapter.session-log-name;
            font-size: 11px;
            vertical-alignment: center;
            vertical-stretch: 0;
            horizontal-stretch: 1;
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: #808080;
        background: #111827;
        vertical-stretch: 1;
        min-height: 160px;

        log-view := ListView {
            scrolled => {
                // Any upward scroll is user-driven; layout growth only moves
                // viewport-y more negative when content is appended.
                root.stick-to-end =
                    log-view.viewport-y <= log-view.visible-height - log-view.viewport-height + 8px;
            }
            for line[i] in LogAdapter.lines: HorizontalLayout {
                padding: 3px;
                Text {
                    text: line;
                    color: #e5e7eb;
                    font-family: "monospace";
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    ActionRow {
        Button {
            text: "Clear view";
            enabled: !LogAdapter.running && LogAdapter.lines.length > 0;
            clicked => { LogAdapter.clear-view(); }
        }
        Button {
            text: "Cancel";
            enabled: LogAdapter.running;
            clicked => { LogAdapter.cancel(); }
        }
    }
}
