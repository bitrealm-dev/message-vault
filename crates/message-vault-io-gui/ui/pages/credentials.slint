import { Button, LineEdit } from "std-widgets.slint";
import {
    AnchoredScrollPage, FormMetrics, OptionGroup, PanelTabBar, SectionDivider,
    StackedComboBox, StackedFieldLabel, StackedHint, StackedLineEdit
} from "../widgets.slint";
import { Theme } from "../theme.slint";
import { LogPanel } from "log-panel.slint";

export global CredentialsAdapter {
    in-out property <string> url;
    in-out property <string> key;
    in-out property <int> panel-tab: 0;
    in-out property <int> operation-index: 0;
    in property <[string]> operation-options;
    in property <bool> enabled: true;

    callback open-help();
    callback verify();
}

export component CredentialsPage inherits VerticalLayout {
    padding: 0;
    spacing: 0;
    alignment: stretch;
    vertical-stretch: 1;

    property <bool> can-verify:
        CredentialsAdapter.url != "" && CredentialsAdapter.key != "";

    PanelTabBar {
        current-index <=> CredentialsAdapter.panel-tab;
        first-title: "Vault Credentials";
        second-title: "Log";
    }

    if CredentialsAdapter.panel-tab == 0: AnchoredScrollPage {
        // Match AdvancedSection heading: bold title with a rule under it.
        VerticalLayout {
            spacing: 0;
            padding: 0;
            vertical-stretch: 0;
            Text {
                text: "Vault Credentials";
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
                vertical-stretch: 0;
                height: 30px;
            }
            SectionDivider { }
        }

        OptionGroup {
            title: "";

            // Flush left inside the group (no stacked-control-indent).
            VerticalLayout {
                spacing: 2px;
                padding: 0;
                vertical-stretch: 0;

                HorizontalLayout {
                    spacing: FormMetrics.field-spacing;
                    padding: 0;
                    alignment: stretch;
                    vertical-stretch: 0;
                    height: 22px;
                    StackedFieldLabel {
                        label: "Vault URL";
                        required: true;
                        indent: false;
                        horizontal-stretch: 1;
                    }
                    TouchArea {
                        horizontal-stretch: 0;
                        mouse-cursor: pointer;
                        clicked => { CredentialsAdapter.open-help(); }
                        Text {
                            text: "Need help?";
                            font-size: 12px;
                            color: Theme.link;
                            vertical-alignment: center;
                        }
                    }
                }
                LineEdit {
                    text <=> CredentialsAdapter.url;
                    placeholder-text: "ex: http://127.0.0.1:8080";
                    horizontal-stretch: 1;
                    height: FormMetrics.row-height;
                    vertical-stretch: 0;
                }
                StackedHint {
                    indent: false;
                    message: "Include protocol (https:// or http://) and port if necessary.";
                }
            }

            StackedLineEdit {
                label: "API Key";
                required: true;
                indent: false;
                password: true;
                placeholder: "Generated in Vault Settings";
                value <=> CredentialsAdapter.key;
            }

            StackedComboBox {
                label: "Vault Operation";
                indent: false;
                model: CredentialsAdapter.operation-options;
                current-index <=> CredentialsAdapter.operation-index;
            }
        }
    }

    if CredentialsAdapter.panel-tab == 1: LogPanel { }

    if CredentialsAdapter.panel-tab == 0: Rectangle {
        vertical-stretch: 0;
        HorizontalLayout {
            padding: FormMetrics.page-padding;
            spacing: 8px;
            alignment: start;
            Button {
                text: "Verify & Continue";
                primary: true;
                enabled: CredentialsAdapter.enabled && root.can-verify;
                clicked => { CredentialsAdapter.verify(); }
            }
        }
    }
}
