import { Button } from "std-widgets.slint";
import {
    LabeledLineEdit, LabeledPathField, LabeledComboBox,
    Hint, DangerHint, ActionRow, SectionHeading, SectionDivider,
    PageSummary, CheckBoxRow, AnchoredScrollPage
} from "../widgets.slint";

export global FormatAdapter {
    in-out property <string> input;
    in-out property <string> output;
    in-out property <int> output-format-index;
    in property <[string]> output-format-options;

    in-out property <int> attachment-media-index;
    in property <[string]> attachment-media-options;
    in-out property <int> max-resolution-index;
    in property <[string]> max-resolution-options;
    in-out property <string> media-max-fps: "30";
    in-out property <string> media-min-size: "20M";
    in-out property <bool> media-skip-efficient: true;

    in-out property <bool> obfuscate;
    in-out property <string> obfuscate-seed;

    in property <bool> show-ffmpeg-warning;
    in property <bool> show-compress-options;
    in property <bool> enabled: true;

    callback browse(string);
    callback media-changed();
    callback run();
    callback clear();
}

export component FormatPage inherits AnchoredScrollPage {
    PageSummary {
        message: "Format an existing Message Vault archive to another format. The input format is automatically detected.";
    }

    LabeledPathField {
        label: "Input directory";
        required: true;
        placeholder: "Prior export folder";
        field-id: "format.input";
        value <=> FormatAdapter.input;
        browse-requested(id) => { FormatAdapter.browse(id); }
    }
    LabeledComboBox {
        label: "Output format";
        model: FormatAdapter.output-format-options;
        current-index <=> FormatAdapter.output-format-index;
    }
    LabeledPathField {
        label: "Output directory";
        required: true;
        placeholder: "Path";
        field-id: "format.output";
        value <=> FormatAdapter.output;
        browse-requested(id) => { FormatAdapter.browse(id); }
    }

    LabeledComboBox {
        label: "Attachments";
        model: FormatAdapter.attachment-media-options;
        current-index <=> FormatAdapter.attachment-media-index;
        selected(_) => { FormatAdapter.media-changed(); }
    }
    if FormatAdapter.obfuscate: Hint {
        message: "Obfuscate replaces all media with shared placeholders (real files are not copied or converted).";
    }
    if FormatAdapter.show-ffmpeg-warning: DangerHint {
        message: "The Convert and Compress & Convert attachment modes need ffmpeg and ffprobe beside the app, in MESSAGE_VAULT_IO_BIN, or on PATH.";
    }
    if FormatAdapter.show-compress-options: LabeledComboBox {
        label: "Max resolution";
        model: FormatAdapter.max-resolution-options;
        current-index <=> FormatAdapter.max-resolution-index;
    }
    if FormatAdapter.show-compress-options: LabeledLineEdit {
        label: "Max fps";
        required: true;
        placeholder: "e.g. 30";
        value <=> FormatAdapter.media-max-fps;
    }
    if FormatAdapter.show-compress-options: LabeledLineEdit {
        label: "Min size";
        required: true;
        placeholder: "e.g. 20M";
        value <=> FormatAdapter.media-min-size;
    }
    if FormatAdapter.show-compress-options: CheckBoxRow {
        text: "Skip already-efficient HEVC";
        checked <=> FormatAdapter.media-skip-efficient;
    }

    SectionDivider { }
    SectionHeading { title: "Options"; }
    CheckBoxRow {
        text: "Obfuscate";
        checked <=> FormatAdapter.obfuscate;
    }
    if FormatAdapter.obfuscate: Hint {
        message: "Names, phones, message text, and media are replaced. Attachment files become placeholders only.";
    }
    if FormatAdapter.obfuscate || FormatAdapter.obfuscate-seed != "": LabeledLineEdit {
        label: "Seed";
        placeholder: "8-hex seed (optional)";
        value <=> FormatAdapter.obfuscate-seed;
    }

    ActionRow {
        Button {
            text: "Clear";
            enabled: FormatAdapter.enabled;
            clicked => { FormatAdapter.clear(); }
        }
        Button {
            text: "Format messages";
            primary: true;
            enabled: FormatAdapter.enabled;
            clicked => { FormatAdapter.run(); }
        }
    }
}
