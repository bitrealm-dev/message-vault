import { Button } from "std-widgets.slint";
import {
    LabeledLineEdit, LabeledPathField, Hint, ActionRow, PageSummary,
    CheckBoxRow, AnchoredScrollPage
} from "../widgets.slint";

export global VaultAdapter {
    in-out property <string> url;
    in-out property <string> key;
    in-out property <string> input;
    in-out property <bool> continue-on-error: true;
    in-out property <bool> force: false;
    in-out property <bool> skip-attachments: false;
    in property <string> source-note;
    in property <bool> enabled: true;

    callback browse(string);
    callback authenticate();
    callback import();
    callback clear();
}

export component VaultPage inherits AnchoredScrollPage {
    PageSummary {
        message: "Import a JSONL archive into Message Vault using an Import API token.";
    }

    LabeledLineEdit {
        label: "Vault URL";
        required: true;
        placeholder: "http://127.0.0.1:8080 or https://app.bitrealm.dev";
        value <=> VaultAdapter.url;
    }
    Hint {
        message: "Include the port when needed (local serve is usually http://127.0.0.1:8080). Hosted TLS can omit it (https://app.bitrealm.dev).";
    }
    LabeledLineEdit {
        label: "Vault key";
        required: true;
        placeholder: "Import API token from Vault Settings";
        password: true;
        value <=> VaultAdapter.key;
    }
    LabeledPathField {
        label: "Input directory";
        required: true;
        placeholder: "JSONL export folder";
        field-id: "vault.input";
        value <=> VaultAdapter.input;
        browse-requested(id) => { VaultAdapter.browse(id); }
    }
    if VaultAdapter.source-note != "": Hint {
        message: VaultAdapter.source-note;
    }

    CheckBoxRow {
        text: "Continue on error";
        checked <=> VaultAdapter.continue-on-error;
    }
    CheckBoxRow {
        text: "Force reprocessing (ignore journal)";
        checked <=> VaultAdapter.force;
    }
    CheckBoxRow {
        text: "Skip attachments";
        checked <=> VaultAdapter.skip-attachments;
    }

    ActionRow {
        Button {
            text: "Clear";
            enabled: VaultAdapter.enabled;
            clicked => { VaultAdapter.clear(); }
        }
        Button {
            text: "Authenticate";
            enabled: VaultAdapter.enabled;
            clicked => { VaultAdapter.authenticate(); }
        }
        Button {
            text: "Import to vault";
            primary: true;
            enabled: VaultAdapter.enabled;
            clicked => { VaultAdapter.import(); }
        }
    }
}
