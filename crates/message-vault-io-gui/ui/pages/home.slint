import { Palette } from "std-widgets.slint";

export global HomeAdapter {
    in property <bool> enabled: true;
    callback vault-import();
    callback convert-messages();
}

component HomeCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked();

    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.border;
    background: card-touch.has-hover && root.enabled
        ? Palette.alternate-background
        : Palette.background;
    vertical-stretch: 0;
    min-height: 72px;

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        alignment: stretch;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            background: #e8eef8;
            vertical-stretch: 0;
            horizontal-stretch: 0;
            Text {
                text: root.glyph;
                font-size: 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: #1e3a5f;
            }
        }

        VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 700;
                color: Palette.control-foreground;
                wrap: word-wrap;
            }
            Text {
                text: root.subtitle;
                font-size: 12px;
                color: #555555;
                wrap: word-wrap;
            }
        }

        Text {
            text: "›";
            font-size: 22px;
            font-weight: 700;
            color: #6b7280;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }

    card-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component HomePage inherits VerticalLayout {
    padding: 24px;
    spacing: 0;
    alignment: center;
    vertical-stretch: 1;

    VerticalLayout {
        spacing: 8px;
        alignment: center;
        vertical-stretch: 0;
        horizontal-stretch: 0;
        max-width: 520px;
        width: 100%;

        Text {
            text: "What was said matters.";
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: "Bring your conversations into one place.";
            font-size: 14px;
            color: #555555;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Rectangle { height: 28px; }

        HomeCard {
            title: "Vault import";
            subtitle: "Upload and unify your message history.";
            glyph: "✈";
            enabled: HomeAdapter.enabled;
            clicked => { HomeAdapter.vault-import(); }
        }

        Rectangle { height: 12px; }

        HomeCard {
            title: "Convert messages (Advanced)";
            subtitle: "Transform message exports between formats.";
            glyph: "↻";
            enabled: HomeAdapter.enabled;
            clicked => { HomeAdapter.convert-messages(); }
        }
    }
}
