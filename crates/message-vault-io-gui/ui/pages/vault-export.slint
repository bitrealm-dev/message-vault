import { Button, Date } from "std-widgets.slint";
import {
    AdvancedSection, AnchoredScrollPage, FormMetrics, PanelTabBar,
    StackedComboBox, StackedDateEdit, StackedHint, StackedLineEdit, StackedPathField
} from "../widgets.slint";
import { LogPanel } from "log-panel.slint";

export global VaultExportAdapter {
    in-out property <int> panel-tab: 0;

    in-out property <int> exporter-index: 0;
    in property <[string]> exporter-options;

    // Empty start/end means export all data.
    in-out property <string> start-date;
    in-out property <string> end-date;
    // Optional Fastmail-style operators (with:, has:attachment, …).
    in-out property <string> search-query;
    in-out property <string> output;
    in-out property <bool> skip-attachments: false;

    in property <bool> enabled: true;
    // Set after a successful Query for the current filters; cleared when filters change.
    in-out property <bool> query-ready: false;
    in-out property <string> query-summary: "";
    // Message count from the last successful Query (for Export "of N" progress).
    in-out property <int> query-message-count: 0;

    callback date-for-text(string) -> Date;
    callback browse(string);
    callback query();
    callback run();

    changed exporter-index => {
        query-ready = false;
        query-summary = "";
        query-message-count = 0;
    }
    changed start-date => {
        query-ready = false;
        query-summary = "";
        query-message-count = 0;
    }
    changed end-date => {
        query-ready = false;
        query-summary = "";
        query-message-count = 0;
    }
    changed search-query => {
        query-ready = false;
        query-summary = "";
        query-message-count = 0;
    }
}

export component VaultExportPage inherits VerticalLayout {
    padding: 0;
    spacing: 0;
    alignment: stretch;
    vertical-stretch: 1;

    PanelTabBar {
        current-index <=> VaultExportAdapter.panel-tab;
        first-title: "Vault Export";
        second-title: "Log";
    }

    if VaultExportAdapter.panel-tab == 0: AnchoredScrollPage {
        AdvancedSection {
            title: "Vault Export";
            open: true;
            grouped: true;

            StackedComboBox {
                label: "Exporter Type";
                model: VaultExportAdapter.exporter-options;
                current-index <=> VaultExportAdapter.exporter-index;
            }
            StackedHint {
                message: "Pulls matching messages from Message Vault (read-only). Uses the Vault URL and API token from Credentials / Vault Import.";
            }

            StackedPathField {
                label: "Output directory";
                required: false;
                placeholder: "Defaults to the folder you launched the app from";
                field-id: "vault_export.output";
                value <=> VaultExportAdapter.output;
                browse-requested(id) => { VaultExportAdapter.browse(id); }
            }
            StackedHint {
                message: "Writes into export-<type>-YYMMDD-HHMMSS under this directory (same pattern as import staging).";
            }

            StackedLineEdit {
                label: "Search";
                placeholder: "Optional: with:alice has:attachment source:imessage";
                value <=> VaultExportAdapter.search-query;
            }
            StackedHint {
                message: "Fastmail-style operators. Leave empty to export all messages (still respects dates below).";
            }

            VerticalLayout {
                spacing: 2px;
                padding: 0;
                vertical-stretch: 0;
                StackedDateEdit {
                    label: "Start Date";
                    placeholder: "Optional";
                    value <=> VaultExportAdapter.start-date;
                    date-for-text(value) => { return VaultExportAdapter.date-for-text(value); }
                }
                StackedHint {
                    message: "Only export messages on or after this date (YYYY-MM-DD). Leave empty for all data.";
                }
            }
            VerticalLayout {
                spacing: 2px;
                padding: 0;
                vertical-stretch: 0;
                StackedDateEdit {
                    label: "End Date";
                    placeholder: "Optional";
                    value <=> VaultExportAdapter.end-date;
                    date-for-text(value) => { return VaultExportAdapter.date-for-text(value); }
                }
                StackedHint {
                    message: "Only export messages before this date (YYYY-MM-DD). Leave empty for all data.";
                }
            }
        }
    }

    if VaultExportAdapter.panel-tab == 1: LogPanel { }

    if VaultExportAdapter.panel-tab == 0: Rectangle {
        vertical-stretch: 0;
        HorizontalLayout {
            padding: FormMetrics.page-padding;
            spacing: 8px;
            alignment: start;
            Button {
                text: "Query";
                enabled: VaultExportAdapter.enabled;
                clicked => { VaultExportAdapter.query(); }
            }
            Button {
                text: "Export";
                primary: true;
                enabled: VaultExportAdapter.enabled && VaultExportAdapter.query-ready;
                clicked => { VaultExportAdapter.run(); }
            }
            if VaultExportAdapter.query-summary != "": Text {
                text: VaultExportAdapter.query-summary;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}
