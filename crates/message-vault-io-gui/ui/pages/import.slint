import { Button, Date } from "std-widgets.slint";
import {
    StackedDateEdit, StackedLineEdit, StackedPathField, StackedComboBox,
    StackedHint, StackedDangerHint, StackedCheckBox, AdvancedSection,
    AnchoredScrollPage, FormMetrics, OptionGroup, PanelTabBar, StackedFieldLabel
} from "../widgets.slint";
import { CompactComboBox } from "../compact-combo-box.slint";
import { LogPanel } from "log-panel.slint";

export global ImportAdapter {
    in-out property <int> panel-tab: 0;
    in-out property <int> format-index: 0;
    in property <[string]> format-options;

    in-out property <string> backup-path;
    in-out property <string> backup-password;

    in-out property <int> attachment-media-index;
    in property <[string]> attachment-media-options;
    in-out property <int> max-resolution-index;
    in property <[string]> max-resolution-options;
    in-out property <string> media-max-fps: "30";
    in-out property <string> media-min-size: "20M";

    in-out property <bool> advanced: false;
    in-out property <string> conversation-filter;
    in-out property <string> start-date;
    in-out property <string> end-date;
    in-out property <bool> obfuscate;
    in-out property <bool> continue-on-error: true;
    in-out property <bool> force: false;

    in property <bool> show-ffmpeg-warning;
    in property <bool> show-compress-options;
    in property <bool> enabled: true;

    callback browse(string);
    callback media-changed();
    callback date-for-text(string) -> Date;
    callback open-help();
    callback run();
}

export component ImportPage inherits VerticalLayout {
    padding: 0;
    spacing: 0;
    alignment: stretch;
    vertical-stretch: 1;

    property <bool> can-import: ImportAdapter.backup-path != "";

    PanelTabBar {
        current-index <=> ImportAdapter.panel-tab;
        first-title: "Import Messages";
        second-title: "Log";
    }

    if ImportAdapter.panel-tab == 0: AnchoredScrollPage {
        Text {
            text: "Import Messages";
            font-size: 16px;
            font-weight: 700;
            vertical-stretch: 0;
        }
        Text {
            text: "Select your messages.";
            font-size: 12px;
            color: #555555;
            wrap: word-wrap;
            vertical-stretch: 0;
        }

        Rectangle { height: 8px; vertical-stretch: 0; }

        OptionGroup {
            title: "";

            VerticalLayout {
                spacing: 2px;
                padding: 0;
                vertical-stretch: 0;

                HorizontalLayout {
                    spacing: FormMetrics.field-spacing;
                    padding: 0;
                    alignment: stretch;
                    vertical-stretch: 0;
                    height: 22px;
                    StackedFieldLabel {
                        label: "Import Format";
                        horizontal-stretch: 1;
                    }
                    TouchArea {
                        horizontal-stretch: 0;
                        mouse-cursor: pointer;
                        clicked => { ImportAdapter.open-help(); }
                        Text {
                            text: "Need help?";
                            font-size: 12px;
                            color: #1d4ed8;
                            vertical-alignment: center;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 0;
                    padding: 0;
                    alignment: stretch;
                    vertical-stretch: 0;
                    height: FormMetrics.row-height;
                    Rectangle {
                        width: FormMetrics.stacked-control-indent;
                        horizontal-stretch: 0;
                    }
                    CompactComboBox {
                        model: ImportAdapter.format-options;
                        current-index <=> ImportAdapter.format-index;
                        horizontal-stretch: 1;
                        height: FormMetrics.row-height;
                        vertical-stretch: 0;
                    }
                }
            }

            StackedPathField {
                label: "iPhone Backup Directory";
                required: true;
                placeholder: "Path to iPhone backup";
                field-id: "import.backup_path";
                value <=> ImportAdapter.backup-path;
                browse-requested(id) => { ImportAdapter.browse(id); }
            }

            StackedLineEdit {
                label: "Encryption password";
                placeholder: "Optional";
                password: true;
                value <=> ImportAdapter.backup-password;
            }

            StackedComboBox {
                label: "Message Attachments";
                model: ImportAdapter.attachment-media-options;
                current-index <=> ImportAdapter.attachment-media-index;
                selected(_) => { ImportAdapter.media-changed(); }
            }
            if ImportAdapter.show-ffmpeg-warning: StackedDangerHint {
                message: "The Convert and Compress & Convert attachment modes need ffmpeg and ffprobe beside the app, in MESSAGE_VAULT_IO_BIN, or on PATH.";
            }
            if ImportAdapter.show-compress-options: OptionGroup {
                title: "";
                StackedComboBox {
                    label: "Target resolution";
                    model: ImportAdapter.max-resolution-options;
                    current-index <=> ImportAdapter.max-resolution-index;
                }
                StackedLineEdit {
                    label: "Max FPS";
                    required: true;
                    placeholder: "e.g. 30";
                    value <=> ImportAdapter.media-max-fps;
                }
                StackedLineEdit {
                    label: "Minimum file size (MB)";
                    required: true;
                    placeholder: "e.g. 20";
                    value <=> ImportAdapter.media-min-size;
                }
            }
        }

        OptionGroup {
            title: "";
            AdvancedSection {
                open <=> ImportAdapter.advanced;
                StackedLineEdit {
                    label: "Participant Filtering";
                    placeholder: "Comma separated list of names and numbers.";
                    value <=> ImportAdapter.conversation-filter;
                }
                StackedHint {
                    message: "Only conversations with the specified participants are exported, including group conversations.";
                }
                StackedDateEdit {
                    label: "Start Date";
                    placeholder: "Optional";
                    value <=> ImportAdapter.start-date;
                    date-for-text(value) => { return ImportAdapter.date-for-text(value); }
                }
                StackedHint {
                    message: "Only import messages on or after this date (YYYY-MM-DD)";
                }
                StackedDateEdit {
                    label: "End Date";
                    placeholder: "Optional";
                    value <=> ImportAdapter.end-date;
                    date-for-text(value) => { return ImportAdapter.date-for-text(value); }
                }
                StackedHint {
                    message: "Only import messages before this date (YYYY-MM-DD)";
                }
                StackedCheckBox {
                    text: "Continue importing after failed message conversion (default)";
                    checked <=> ImportAdapter.continue-on-error;
                }
                StackedCheckBox {
                    text: "Force re-upload";
                    checked <=> ImportAdapter.force;
                }
                StackedCheckBox {
                    text: "Obfuscate - All message data is anonymized";
                    checked <=> ImportAdapter.obfuscate;
                }
                if ImportAdapter.obfuscate: StackedHint {
                    message: "Obfuscate replaces all media with shared placeholders (real files are not copied or converted).";
                }
            }
        }
    }

    if ImportAdapter.panel-tab == 1: LogPanel { }

    if ImportAdapter.panel-tab == 0: Rectangle {
        vertical-stretch: 0;
        HorizontalLayout {
            padding: FormMetrics.page-padding;
            spacing: 8px;
            alignment: start;
            Button {
                text: "Import";
                primary: true;
                enabled: ImportAdapter.enabled && root.can-import;
                clicked => { ImportAdapter.run(); }
            }
        }
    }
}
