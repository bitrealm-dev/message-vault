# Copy to inventory/hosts (gitignored) and fill in your VPS.
#
#   cp inventory/hosts.example inventory/hosts
#
# Then:
#   ansible-playbook playbooks/site.yml

[vault]
# app.example.com ansible_host=203.0.113.10 ansible_user=ubuntu
vps.example.com ansible_host=REPLACE_WITH_VPS_IP ansible_user=ubuntu
