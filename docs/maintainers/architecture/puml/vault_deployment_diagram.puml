@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Deployment: Message Vault from source (developer workstation)

Deployment_Node(workstation, "Developer workstation", "Linux, macOS, or Windows") {
    Deployment_Node(browser, "Web browser", "Chrome, Firefox, Safari, or WebKit") {
        Container(spa, "Webpage", "React SPA", "GET / from the vault server. API calls go to /v1 on the same origin.")
    }

    Deployment_Node(tauri, "Desktop process", "cargo tauri dev") {
        Container(desktop, "Desktop App", "Tauri v2 native window", "Extract and Format. UI from Vite, vault data from /v1.")
        Container(vite, "Vite", "Node.js, localhost:5173", "Dev server for the Tauri WebView. Serves web/ live.")
    }

    Deployment_Node(backend, "Message Vault backend", "cargo run -p message-vault-server -- serve") {
        Deployment_Node(proc, "Server process", "One OS process on 127.0.0.1:8080") {
            Container(web, "Web", "HTTP GET /", "Returns the webpage compiled from web/. Same origin as the API.")
            Container(api, "API", "HTTP /v1", "Auth, import, browse, export, assets. Used by the browser and the desktop app.")
        }
    }

    Deployment_Node(fs, "Filesystem", "Repo working directory") {
        Container(web_src, "web/", "React + Vite source", "Vite serves this folder to Tauri. Server GET / serves the same app when built into static/.")
        ContainerDb(db, "SQLite", "data/vault.db", "Messages, contacts, accounts. Embedded; not a separate process.")
        Container(data, "data/", "Attachment files", "Per-account source folders and asset bytes on disk.")
    }
}

System_Ext(backups, "Phone backup files", "Anywhere on local disk. Desktop reads them during Extract. Import uploads into the vault.")

Rel(spa, web, "GET /")
Rel(spa, api, "/v1")
Rel(desktop, vite, "Loads UI")
Rel(desktop, api, "/v1")
Rel(vite, web_src, "Serves live")
Rel(web, web_src, "Built copy in static/")
Rel(api, db, "rusqlite")
Rel(api, data, "Reads and writes assets")
Rel(desktop, backups, "Reads during Extract")

@enduml
