# Docker Compose reads a file named `.env` in the directory where you run
# `docker compose`. That is the repository root, not this `docker/` folder.
# Copy this file there, then edit the copy:
#
#   cp docker/.env.example .env
#
# A line that starts with `#` is a comment. Remove the `#` in front of a
# `NAME=value` line to turn that setting on. The values already uncommented
# are the usual defaults.

# --- Which Compose file to start ---

# Docker Compose is the tool that starts the vault container from a YAML file.
# COMPOSE_FILE picks which YAML file `docker compose up` uses when you do not
# pass `-f`. Day-to-day work from a clone is ./scripts/run-vault-dev.sh, not Compose.
#
# docker/compose.release.yml builds a smaller image from this checkout, the
# same shape as a shipped install. The website is baked into the image. After
# a code change, rebuild: docker compose -f docker/compose.release.yml up --build
#
# docker/compose.yml pulls the published image from Docker Hub. It is a sample
# for people who are not working from a clone. Do not point COMPOSE_FILE at it
# from this repository.
#
# To use a file once without changing this setting:
#   docker compose -f docker/compose.release.yml up --build
COMPOSE_FILE=docker/compose.release.yml

# --- Who owns files the container writes ---

# A bind mount is a folder on the laptop that the container can write into
# (for example `data/` and `staging/`). If the container runs as root, those
# files belong to root and the laptop account cannot delete them.
#
# UID and GID are the numeric Linux user id and group id. Set them to the
# output of `id -u` and `id -g` on this machine so new files belong to the
# person who ran Compose. Bash sets UID by itself. It does not set GID, so
# GID must appear here.
UID=1000
GID=1000

# --- First boot and login ---

# When `data/vault.db` is missing, the container can load sample conversations
# so the website is clickable without a phone backup. Set DEMO_DATA to true,
# 1, or yes to do that. Set it to false for an empty vault; create an account
# in the website after start.
#
# Changing DEMO_DATA later does not add or remove accounts. The seed runs only
# when the database file is not there yet.
DEMO_DATA=true

# How people sign in. The website shows only one of these modes.
#
# local — username and password stored by the vault.
# hanko — sign-in through Hanko Cloud. Also set HANKO_API_URL.
VAULT_AUTH=local

# Hanko Cloud project URL. Required when VAULT_AUTH=hanko. In the Hanko
# dashboard, allow http://localhost:3000 as an origin if you test on a laptop.
# Tagged Docker Hub images can bake NEXT_PUBLIC_HANKO_API_URL in at build time
# from the HANKO_API_URL GitHub secret.
# HANKO_API_URL=https://<project>.hanko.io
# NEXT_PUBLIC_HANKO_API_URL=https://<project>.hanko.io

# --- Hosted Try it (guest copies) ---

# On a public site, Try it gives each visitor a private copy of the sample
# inbox instead of one shared demo login. Set GUEST_DEMO_POOL to true to turn
# that on. Leave it false on a laptop so sign-in still uses the shared demo
# username.
GUEST_DEMO_POOL=false

# How many unused guest copies to keep ready, and the cap on copies in the
# pool. These apply only when GUEST_DEMO_POOL is true. Defaults are 2 and 20.
# GUEST_POOL_MIN=2
# GUEST_POOL_MAX=20

# How long a guest session lasts, in seconds. The smallest allowed value is
# 60. The default is 86400 (24 hours). After that the copy is recycled.
# GUEST_SESSION_SECS=86400

# --- Paths inside the container ---

# SQLite is the database file. Attachments (photos, voice notes) live next to
# it under VAULT_DATA_DIR. Change these only if the volume mount is not
# /app/data.
# VAULT_DB=/app/data/vault.db
# VAULT_DATA_DIR=/app/data

# Address the server listens on inside the container. 0.0.0.0 means every
# container network interface. Compose then publishes that as port 8080 on
# the laptop.
# HOSTNAME=0.0.0.0

# Upload chunk size in bytes when a client sends an attachment in parts.
# Must be at least 1 and no larger than the size in config. Used to shrink
# chunks in tests. Leave unset for normal use.
# VAULT_ASSET_PART_SIZE=
