# Which Compose file to use (Docker reads COMPOSE_FILE automatically).
#   compose-dev.yml     — laptop: bind-mount + hot reload (default)
#   compose-release.yml — slim image built from this checkout
#   compose-hub.yml     — pull image from Docker Hub (VPS)
#
# Or pass -f explicitly:
#   docker compose -f compose-release.yml up --build
#   docker compose -f compose-hub.yml up -d
#   VAULT_IMAGE=mbeisser1/message-vault:v0.1.0   # optional pin for hub
COMPOSE_FILE=compose-dev.yml

VAULT_MODE=demo
# VAULT_IMAGE=mbeisser1/message-vault:latest

# Auth: local (username/password, default) or hanko (prod / app.bitrealm.dev).
# Exclusive modes — login UI shows only one. Hanko allowed origin for prod:
#   https://app.bitrealm.dev
# Release/hub images bake NEXT_PUBLIC_HANKO_API_URL at build time — rebuild when
# the URL changes. Dev can set it at runtime.
# VAULT_AUTH=local
# VAULT_AUTH=hanko
# HANKO_API_URL=https://<project>.hanko.io
# NEXT_PUBLIC_HANKO_API_URL=https://<project>.hanko.io
VAULT_AUTH=local
