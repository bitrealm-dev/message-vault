# Compose profile (see plain-English notes at top of docker-compose.yml).
#   dev     — develop on your laptop (default)
#   release — build a ready-to-run image from this folder
#   hub     — download the ready-to-run image from Docker Hub (VPS)
#
# COMPOSE_PROFILES=release docker compose up --build
# COMPOSE_PROFILES=hub docker compose up -d
# VAULT_IMAGE=mbeisser1/message-vault:v0.1.0   # optional pin for hub
COMPOSE_PROFILES=dev
VAULT_MODE=demo
# VAULT_IMAGE=mbeisser1/message-vault:latest

# Auth: local (username/password, default) or hanko (prod / app.bitrealm.dev).
# Exclusive modes — login UI shows only one. Hanko allowed origin for prod:
#   https://app.bitrealm.dev
# Release/hub images bake NEXT_PUBLIC_HANKO_API_URL at build time — rebuild when
# the URL changes. Dev profile can set it at runtime.
# VAULT_AUTH=local
# VAULT_AUTH=hanko
# HANKO_API_URL=https://<project>.hanko.io
# NEXT_PUBLIC_HANKO_API_URL=https://<project>.hanko.io
VAULT_AUTH=local

