# Which Compose file to use (Docker reads COMPOSE_FILE automatically).
#   docker/compose.dev.yml     — laptop: bind-mount + hot reload (default)
#   docker/compose.release.yml — slim image built from this checkout
#   docker/compose.yml         — published Hub image (not used from a clone)
#
# Or pass -f explicitly:
#   docker compose -f docker/compose.release.yml up --build
#
# Production Hub + nginx (Bitrealm VPS) lives in the private message-vault-ops repo.
COMPOSE_FILE=docker/compose.dev.yml

# Linux user for bind-mounted writes (staging/, data/).
# Set these to `id -u` and `id -g` on this machine.
UID=1000
GID=1000

# Seed the demo dataset on first boot (empty volume only). Set false for an empty vault.
DEMO_DATA=true

# Auth: local (username/password, default) or hanko.
# Exclusive modes — login UI shows only one.
# For local Hanko testing, also set your Hanko project API URL (and allow
# http://localhost:3000 as an origin in Hanko Cloud).
# Release/Hub images bake NEXT_PUBLIC_HANKO_API_URL at build time (GitHub secret
# HANKO_API_URL on tagged Docker publishes).
# VAULT_AUTH=local
# VAULT_AUTH=hanko
# HANKO_API_URL=https://<project>.hanko.io
# NEXT_PUBLIC_HANKO_API_URL=https://<project>.hanko.io
VAULT_AUTH=local
